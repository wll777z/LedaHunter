# Credenciais usadas na camada do servidor.
# Copie este arquivo para .env e preencha os valores.

# Postgres/Supabase (unidade de trabalho por usuário)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Chave da API do Google Places
GOOGLE_PLACES_API_KEY=

#Provedor de IA (opcional)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Porta do backend
PORT=4000

# Se true, integrações reais (Maps, IA) são desativadas em dev.
# O app mostra um estado de "integração pendente" até que as chaves sejam definidas.
INTEGRATIONS_DISABLED=true

# Segredo para assinar tokens de sessão (mude em produção)
JWT_SECRET=change-me-in-production
